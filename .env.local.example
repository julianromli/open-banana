# AI Provider Configuration
# Options: BYTEPLUS | FAL-AI (default: BYTEPLUS)
AI_PROVIDER=BYTEPLUS

# BytePlus API (primary by default)
# Get your key from BytePlus console
BYTEPLUS_API_KEY=your_byteplus_api_key

# fal.ai API (fallback by default)
# Get your key from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_key

# Clerk Authentication
# Get your keys from: https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Clerk URLs (optional - these are the defaults)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Redis (Upstash) - for rate limiting
# Get your keys from: https://console.upstash.com/
KV_REST_API_URL=your_redis_url
KV_REST_API_TOKEN=your_redis_token

# Alternative Upstash naming (also supported by the API route)
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token
